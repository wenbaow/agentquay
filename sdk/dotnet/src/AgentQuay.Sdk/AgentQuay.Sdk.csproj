<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AgentQuay</RootNamespace>
    <AssemblyName>AgentQuay.Sdk</AssemblyName>

    <!-- NuGet 包元数据（设计文档 §4.2：NuGet 包分发 AgentQuay.Sdk） -->
    <PackageId>AgentQuay.Sdk</PackageId>
    <Version>0.3.0</Version>
    <Authors>AgentQuay</Authors>
    <Description>让 AI Agent 通过标准 MCP 协议发现并调用你的桌面应用方法（设计文档 §4.2）。加个 [AgentTool] 注解，其余全部由框架处理。</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;agent;agentquay;bridge;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/wenbaow/agentquay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenbaow/agentquay</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内嵌 Bridge 二进制：随 NuGet 包以 contentFiles 分发（自动复制到宿主输出目录），
         开发期 ProjectReference 场景由 CopyToOutputDirectory 传播。 -->
    <None Include="bridge_bin/**" Pack="true"
          PackagePath="contentFiles/any/any/bridge_bin/"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- 包自述文件 -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>


  <ItemGroup>
    <!-- 单测程序集可见 internal（PageRouter / ToolBinding 等页面路由核心）。 -->
    <InternalsVisibleTo Include="AgentQuay.Sdk.Tests" />
  </ItemGroup>
</Project>